NODE_ENV=development
PORT=3000
STORE_ID=cabeca-do-cachorro
STORE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Banco EXCLUSIVO desta API, separado do banco do MuiraSoft.
# Habilite após criar o banco e um usuário com acesso somente a ele.
DATABASE_ENABLED=false
DATABASE_URL=
DATABASE_SSL=false
# DATABASE_URL=mysql://loja:senha-codificada@127.0.0.1:3306/cabeca_cachorro

# Preencha os quatro campos juntos. Base da instalação, sem /integracao/v1.
# Credencial de servidor: nunca usar variáveis VITE_ ou enviar ao navegador.
MUIRASOFT_BASE_URL=
MUIRASOFT_TOKEN=
MUIRASOFT_COMPANY_ID=
MUIRASOFT_CHANNEL=
MUIRASOFT_TIMEOUT_MS=5000

# Ativação explícita, com chaves reais; desabilitado em desenvolvimento/testes.
OBSERVE_ENABLED=false
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Conta do comprador: requer migração e chave base64 de 32 bytes independente.
AUTH_ENABLED=false
AUTH_ENCRYPTION_KEY=
# Manter OBSERVE_ENABLED=false enquanto autenticação estiver ativa (corpos sensíveis).

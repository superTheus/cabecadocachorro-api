        "summary": "Conferir conexão",
        "description": "Escopo: token válido. Contexto da conta, empresa e canal vem da credencial.",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "nome": {
                      "type": "string"
                    },
                    "empresa": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "canal": {
                      "type": "string"
                    },
                    "origem": {
                      "type": "string"
                    },
                    "escopos": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "estoque_politica": {
                      "type": "string",

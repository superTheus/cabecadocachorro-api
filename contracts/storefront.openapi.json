                      "type": "string"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "email_verified": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "headers": {
              "Set-Cookie": {
                "schema": {
                  "type": "string"
                },
                "description": "cabeca_session: HttpOnly; SameSite=Lax; Secure em produção; Path=/api/v1; sete dias."
              }
            }
          },
          "400": {
            "description": "Dados ou token inválidos/expirados"
          },
          "401": {
            "description": "Credencial, confirmação ou sessão inválida"
          },
          "403": {
            "description": "Origem não autorizada"
          },
          "429": {
            "description": "Limite atingido"
          },
          "503": {
            "description": "Módulo ou banco indisponível"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Origem exata de STORE_URL."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "email",
                  "password"
                ],
                "properties": {
                  "email": {
                    "type": "string"

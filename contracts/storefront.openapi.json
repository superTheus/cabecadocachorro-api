{
  "openapi": "3.0.3",
  "info": {
    "title": "Cabeça do Cachorro API da Loja",
    "version": "0.1.0",
    "description": "Contrato público implementado na etapa 1: somente saúde. Autenticação de compradores, catálogo, checkout e pedidos públicos serão definidos nas etapas próprias; métodos internos do adaptador MuiraSoft não são rotas públicas."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Desenvolvimento local. Configure host e porta do ambiente."
    }
  ],
  "tags": [
    {
      "name": "Saúde",
      "description": "Sondas sem dados comerciais, credenciais ou conteúdo de respostas do MuiraSoft."
    }
  ],
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "operationId": "checkLiveness",
        "tags": [
          "Saúde"
        ],
        "summary": "Verificar se o processo HTTP está respondendo",
        "description": "Não consulta banco ou MuiraSoft e não indica prontidão comercial.",
        "responses": {
          "200": {
            "description": "Processo respondendo.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador UUID gerado pelo servidor para esta requisição.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "operationId": "checkReadiness",
        "tags": [
          "Saúde"
        ],
        "summary": "Verificar banco e integração configurados",
        "description": "Somente retorna 200 quando banco e conexão MuiraSoft estiverem disponíveis e o contexto autenticado corresponder à empresa e ao canal configurados. Banco desabilitado explicitamente no desenvolvimento resulta em 503. A resposta pública não identifica o lojista nem a causa interna da falha.",
        "responses": {
          "200": {
            "description": "Dependências prontas.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador UUID gerado pelo servidor para esta requisição.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                },
                "example": {
                  "status": "ready",
                  "checks": {
                    "database": "up",
                    "muirasoft": "up"
                  }
                }
              }
            }
          },
          "503": {
            "description": "Pelo menos uma dependência indisponível ou não configurada.",
            "headers": {
              "X-Request-Id": {
                "description": "Identificador UUID gerado pelo servidor para esta requisição.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotReady"
                },
                "example": {
                  "status": "not_ready",
                  "checks": {
                    "database": "disabled",
                    "muirasoft": "not_configured"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "operationId": "customerRegister",
        "summary": "register",
        "description": "Conta do comprador; cookies protegidos, erros genéricos e limitação persistente. Tokens jamais retornam na resposta.",
        "responses": {
          "202": {
            "description": "Perfil seguro ou confirmação da solicitação.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados ou token inválidos/expirados"
          },
          "401": {
            "description": "Credencial, confirmação ou sessão inválida"
          },
          "403": {
            "description": "Origem não autorizada"
          },
          "429": {
            "description": "Limite atingido"
          },
          "503": {
            "description": "Módulo ou banco indisponível"
          }
        },
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Origem exata de STORE_URL."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "email",
                  "password"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 12,
                    "maxLength": 256
                  }
                }
              }
            }
          }
        }
      }
    },

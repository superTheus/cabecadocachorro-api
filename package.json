{
  "name": "cabeca-cachorro-api",
  "version": "0.0.1",
  "description": "API da loja Cabeça do Cachorro com integração ao MuiraSoft",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start --env-file .env",
    "start:dev": "nest start --watch --env-file .env",
    "start:debug": "nest start --debug --watch --env-file .env",
    "start:prod": "node --env-file-if-exists=.env dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "type-check": "tsc --noEmit --incremental false",
    "test:integration": "npm run build && node test/integration/muirasoft-http.mjs",
    "test:database": "npm run build && node test/database/foundation.mjs",
    "db:migrate": "npm run build && node --env-file-if-exists=.env dist/commands/migrations.js run",
    "db:status": "npm run build && node --env-file-if-exists=.env dist/commands/migrations.js show",
    "db:revert": "npm run build && node --env-file-if-exists=.env dist/commands/migrations.js revert",
    "integration:check": "npm run build && node --env-file-if-exists=.env dist/commands/muirasoft-check.js",
    "store:bind": "npm run build && node --env-file-if-exists=.env dist/commands/bind-store.js",
    "test:contracts": "node --test test/contracts.test.mjs",
    "contracts:prepare": "node scripts/prepare-muirasoft-contract.mjs",
    "test:collection": "npm run build && node scripts/test-http-collection.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-express": "^12.0.1",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
